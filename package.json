{
  "name": "@leanprover/workbench-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "collab-server",
    "shared",
    "vscode-workbench"
  ],
  "scripts": {
    "prepare": "husky && next typegen && prisma generate",
    "watch": "concurrently --names collab-server,vscode-workbench 'npm run watch:collab-server' 'npm run watch:vscode-workbench'",
    "watch:collab-server": "npm --workspace collab-server run watch",
    "watch:vscode-workbench": "npm --workspace vscode-workbench run watch",
    "tsc": "concurrently --names next,packages 'npm run tsc:workbench-app' 'npm run tsc --workspaces'",
    "tsc:workbench-app": "tsc",
    "lint": "eslint && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "prettier": "prettier --check .",
    "prettier:fix": "prettier --write ."
  },
  "dependencies": {
    "@conform-to/zod": "^1.21.1",
    "@hocuspocus/provider": "^4.0.0",
    "@leanprover/workbench-shared": "*",
    "@prisma/adapter-better-sqlite3": "^7.7.0",
    "@prisma/client": "^7.7.0",
    "better-auth": "^1.6.2",
    "chokidar": "^5.0.0",
    "next": "^16.2.3",
    "prisma": "^7.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "swr": "^2.4.1",
    "ws": "^8.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "^16.2.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-no-relative-import-paths": "^1.6.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --cache --fix",
      "prettier --write"
    ],
    "*.{json,css}": "prettier --write"
  }
}

{
  "name": "workbench",
  "displayName": "Lean 4 - Workbench",
  "description": "Lean Workbench integration for VS Code",
  "version": "0.0.1",
  "private": true,
  "publisher": "leanprover",
  "engines": {
    "vscode": "^1.122.1"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/leanprover/lean-workbench"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "enabledApiProposals": [
    "textDocumentChangeReason",
    "extensionsAny"
  ],
  "contributes": {
    "commands": [
      {
        "command": "leanprover-workbench.previewFile",
        "title": "Preview File",
        "category": "Lean Workbench"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "leanprover-workbench.previewFile",
          "when": "resourceExtname == .html",
          "group": "1_leanprover_workbench"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "leanprover-workbench-view-container",
          "title": "Lean Workbench",
          "icon": "media/logo.svg"
        }
      ]
    },
    "views": {
      "leanprover-workbench-view-container": [
        {
          "id": "leanprover-workbench-view",
          "name": "",
          "icon": ""
        }
      ]
    }
  },
  "main": "./dist/extension.js",
  "scripts": {
    "watch": "concurrently --names esbuild,tsc 'npm run watch:esbuild' 'npm run watch:tsc'",
    "watch:esbuild": "node esbuild.mjs --watch",
    "watch:tsc": "tsc --watch --preserveWatchOutput",
    "tsc": "tsc",
    "build": "tsc && node esbuild.mjs --production",
    "vscode:prepublish": "npm run build",
    "test": "tsc && node esbuild.mjs --tests && vscode-test"
  },
  "devDependencies": {
    "@hocuspocus/server": "^4.1",
    "@types/mocha": "^10.0",
    "@types/vscode": "~1.120",
    "@types/ws": "^8.18",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5",
    "esbuild": "^0.28"
  },
  "dependencies": {
    "@hocuspocus/provider": "^4.0",
    "minimatch": "^10.2",
    "ws": "^8.20",
    "zod": "^4.4"
  }
}

<!DOCTYPE html>
<html>
<head>
<%- include('_head', { title: projectName + ' - Lean Workbench' }) %>
</head>
<body class="page-session">
<nav>
  <a class="logo" href="/"><img src="/static/lean-logo.svg" alt="Lean" class="logo-img"><span class="logo-text">Lean Workbench</span></a>
  <span class="sep">/</span>
  <a class="breadcrumb" href="/<%= ownerUsername %>/"><%= ownerUsername %></a>
  <span class="sep">/</span>
  <a class="breadcrumb project" href="/<%= ownerUsername %>/<%= encodeURIComponent(projectName) %>/"><%= projectName %></a>
  <% if (!isOwner) { %>
  <span class="ephemeral-badge">ephemeral</span>
  <% } %>
  <span class="spacer"></span>
  <%- include('_avatar-menu', { username: viewerUsername, avatarUrl, isAdmin, links: [] }) %>
</nav>
<iframe id="editor-frame"></iframe>
<script>
  fetch("/api/sessions/<%= ownerUsername %>/<%= encodeURIComponent(projectName) %>", { method: "PUT" })
    .then(r => { if (!r.ok) throw new Error(r.statusText); return r.json(); })
    .then(data => { document.getElementById("editor-frame").src = data.iframeSrc; })
    .catch(err => { document.getElementById("editor-frame").srcdoc = "<p>Failed to start editor session: " + err.message + "</p>"; });
</script>
</body>
</html>

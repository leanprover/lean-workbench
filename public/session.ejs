<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title><%= projectName %> - Lean Workbench</title>
<link rel="icon" href="/static/favicon.ico">
<link rel="stylesheet" href="/static/style.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap">
</head>
<body class="page-session">
<nav>
  <a class="logo" href="/"><img src="/static/lean-logo.svg" alt="Lean" class="logo-img"><span class="logo-text">Lean Workbench</span></a>
  <span class="sep">/</span>
  <a class="breadcrumb" href="/<%= ownerUsername %>/"><%= ownerUsername %></a>
  <span class="sep">/</span>
  <a class="breadcrumb project" href="/<%= ownerUsername %>/<%= encodeURIComponent(projectName) %>/"><%= projectName %></a>
  <% if (!isOwner) { %>
  <span class="ephemeral-badge">ephemeral</span>
  <% } %>
  <span class="spacer"></span>
  <%- include('_avatar-menu', { username: viewerUsername, avatarUrl, isAdmin, links: [{ href: '/logout', label: 'Logout' }] }) %>
</nav>
<iframe src="<%= iframeSrc %>"></iframe>
</body>
</html>

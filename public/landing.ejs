<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Lean Workbench</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Open Sans', Arial, sans-serif; color: #333; }
  nav { position: sticky; top: 0; z-index: 1000; background: rgba(249, 251, 253, 0.81); backdrop-filter: blur(10px); display: flex; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid #E4EBF3; }
  nav .logo { display: flex; align-items: center; margin-right: 1.5rem; text-decoration: none; }
  nav .logo img { height: 20px; }
  nav .spacer { flex: 1; }
  nav a.nav-link { text-decoration: none; color: #333; font-weight: 500; font-size: 0.9rem; padding: 0.75rem 1rem; border-radius: 0.5rem; transition: all 0.2s; position: relative; }
  nav a.nav-link:hover { color: #386EE0; background: rgba(56, 110, 224, 0.08); }
  main { max-width: 600px; margin: 40px auto; padding: 0 20px; }
  h1 { margin-bottom: 4px; }
  h1 + p { color: #607D8B; margin-top: 0; }
  .login-link { display: inline-block; margin: 20px 0; padding: 10px 20px; font-size: 14px; background: #386EE0; color: #fff; text-decoration: none; border-radius: 0.5rem; font-weight: 500; transition: background 0.2s; }
  .login-link:hover { background: #1D4ED8; }
  .welcome { margin: 20px 0; }
  .welcome a { color: #386EE0; text-decoration: none; font-weight: 500; }
  .welcome a:hover { color: #1D4ED8; text-decoration: underline; }
  #users { margin-top: 24px; }
  #users a { display: block; padding: 6px 0; color: #386EE0; text-decoration: none; }
  #users a:hover { text-decoration: underline; }
  #no-users { color: #90a4ae; display: none; }
</style>
</head>
<body>
<nav>
  <a class="logo" href="/"><img src="/static/lean-logo.svg" alt="Lean"></a>
  <span class="spacer"></span>
<% if (user) { %>
  <a class="nav-link" href="/<%= user.username %>/"><%= user.username %></a>
  <a class="nav-link" href="/logout">Logout</a>
<% } else { %>
  <a class="nav-link" href="/auth/github">Login</a>
<% } %>
</nav>
<main>
<h1>Lean Workbench</h1>
<p>Multi-user sandboxed VS Code server.</p>

<% if (user) { %>
  <div class="welcome">
    <h2>Welcome, <%= user.username %></h2>
    <p><a href="/<%= user.username %>/">Go to your projects</a></p>
  </div>
<% } else { %>
  <h2>Launch a session</h2>
  <a class="login-link" href="/auth/github">Login with GitHub</a>
<% } %>

<h2>Active users</h2>
<div id="users"><span id="no-users">No active users.</span></div>
</main>

<script>
const usersDiv = document.getElementById('users');
const noUsers = document.getElementById('no-users');

async function loadUsers() {
  try {
    const res = await fetch('/api/status');
    const data = await res.json();
    const alive = Object.entries(data.sessions).filter(([, s]) => s.alive);
    const names = [...new Set(alive.map(([key]) => key.split('/')[0]))];
    if (names.length === 0) {
      noUsers.style.display = 'inline';
      return;
    }
    noUsers.style.display = 'none';
    usersDiv.innerHTML = '';
    for (const name of names) {
      const a = document.createElement('a');
      a.href = '/' + name + '/';
      a.textContent = name;
      usersDiv.appendChild(a);
    }
  } catch {}
}

loadUsers();
</script>
</body>
</html>

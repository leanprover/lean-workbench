<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Lean Workbench</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<nav>
  <a class="logo" href="/"><img src="/static/lean-logo.svg" alt="Lean"><span class="logo-text">Workbench</span></a>
  <span class="spacer"></span>
<% if (user) { %>
  <div class="avatar-menu">
    <button class="avatar-btn">
    <% if (user.avatarUrl) { %>
      <img src="<%= user.avatarUrl %>" alt="<%= user.username %>">
    <% } else { %>
      <span class="avatar-placeholder"><%= user.username[0].toUpperCase() %></span>
    <% } %>
    </button>
    <div class="avatar-dropdown">
      <div class="avatar-dropdown-user"><%= user.username %></div>
      <a href="/<%= user.username %>/">Projects</a>
      <a href="/logout">Logout</a>
    </div>
  </div>
<% } else { %>
  <a class="nav-link" href="/auth/github">Login</a>
<% } %>
</nav>
<main style="max-width: 600px;">
<h1>Lean Workbench</h1>
<p>Multi-user sandboxed VS Code server.</p>

<% if (user) { %>
  <div class="welcome">
    <h2>Welcome, <%= user.username %></h2>
    <p><a href="/<%= user.username %>/">Go to your projects</a></p>
  </div>
<% } else { %>
  <h2>Launch a session</h2>
  <a class="login-link" href="/auth/github">Login with GitHub</a>
<% if (devMode) { %>
  <a class="login-link" href="/dev-login">Dev Login</a>
<% } %>
<% } %>
</main>
</body>
</html>

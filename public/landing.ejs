<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Lean Workbench</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/style.css">
</head>
<body>
<nav>
  <a class="logo" href="/"><img src="/static/lean-logo.svg" alt="Lean"></a>
  <span class="spacer"></span>
<% if (user) { %>
  <a class="nav-link" href="/<%= user.username %>/"><%= user.username %></a>
  <a class="nav-link" href="/logout">Logout</a>
<% } else { %>
  <a class="nav-link" href="/auth/github">Login</a>
<% } %>
</nav>
<main style="max-width: 600px;">
<h1>Lean Workbench</h1>
<p>Multi-user sandboxed VS Code server.</p>

<% if (user) { %>
  <div class="welcome">
    <h2>Welcome, <%= user.username %></h2>
    <p><a href="/<%= user.username %>/">Go to your projects</a></p>
  </div>
<% } else { %>
  <h2>Launch a session</h2>
  <a class="login-link" href="/auth/github">Login with GitHub</a>
<% } %>

<h2>Active users</h2>
<div id="users"><span id="no-users">No active users.</span></div>
</main>

<script>
const usersDiv = document.getElementById('users');
const noUsers = document.getElementById('no-users');

async function loadUsers() {
  try {
    const res = await fetch('/api/status');
    const data = await res.json();
    const alive = Object.entries(data.sessions).filter(([, s]) => s.alive);
    const names = [...new Set(alive.map(([key]) => key.split('/')[0]))];
    if (names.length === 0) {
      noUsers.style.display = 'inline';
      return;
    }
    noUsers.style.display = 'none';
    usersDiv.innerHTML = '';
    for (const name of names) {
      const a = document.createElement('a');
      a.href = '/' + name + '/';
      a.textContent = name;
      usersDiv.appendChild(a);
    }
  } catch {}
}

loadUsers();
</script>
</body>
</html>

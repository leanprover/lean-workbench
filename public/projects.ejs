<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title><%= username %> - Projects - Lean Workbench</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body { font-family: 'Open Sans', Arial, sans-serif; color: #333; }
  nav { position: sticky; top: 0; z-index: 1000; background: rgba(249, 251, 253, 0.81); backdrop-filter: blur(10px); display: flex; align-items: center; padding: 1.5rem 2rem; border-bottom: 1px solid #E4EBF3; }
  nav .logo { display: flex; align-items: center; margin-right: 1.5rem; text-decoration: none; }
  nav .logo img { height: 20px; }
  nav .sep { margin: 0 0.25rem; color: #90a4ae; }
  nav .user { font-weight: 500; font-size: 0.9rem; color: #333; }
  nav .spacer { flex: 1; }
  nav a.nav-link { text-decoration: none; color: #333; font-weight: 500; font-size: 0.9rem; padding: 0.75rem 1rem; border-radius: 0.5rem; transition: all 0.2s; }
  nav a.nav-link:hover { color: #386EE0; background: rgba(56, 110, 224, 0.08); }
  main { max-width: 700px; margin: 40px auto; padding: 0 20px; }
  h1 { margin-bottom: 4px; }
  h1 + p { color: #607D8B; margin-top: 0; }
  .new-project { margin: 20px 0; padding: 16px; background: #f5f7fa; border: 1px solid #E4EBF3; border-radius: 0.5rem; }
  .new-project h3 { margin: 0 0 10px; }
  .new-project input, .new-project textarea { display: block; width: 100%; margin-bottom: 8px; padding: 8px 10px; font-size: 14px; border: 1px solid #D1D9E2; border-radius: 0.5rem; font-family: inherit; }
  .new-project input:focus, .new-project textarea:focus { outline: none; border-color: #386EE0; box-shadow: 0 0 0 3px rgba(56, 110, 224, 0.12); }
  .new-project textarea { height: 50px; resize: vertical; }
  .new-project button { padding: 8px 20px; font-size: 14px; background: #386EE0; color: #fff; border: none; border-radius: 0.5rem; cursor: pointer; font-weight: 500; font-family: inherit; transition: background 0.2s; }
  .new-project button:hover { background: #1D4ED8; }
  .project-list { list-style: none; padding: 0; }
  .project-list li { padding: 12px 0; border-bottom: 1px solid #E4EBF3; display: flex; align-items: center; }
  .project-list li:last-child { border-bottom: none; }
  .project-list .info { flex: 1; }
  .project-list .info a { color: #386EE0; text-decoration: none; font-weight: 500; }
  .project-list .info a:hover { text-decoration: underline; }
  .project-list .info .desc { color: #607D8B; font-size: 13px; margin-top: 2px; }
  .project-list .actions button { margin-left: 6px; padding: 4px 12px; font-size: 12px; border: 1px solid #D1D9E2; border-radius: 0.25rem; background: #fff; cursor: pointer; font-family: inherit; transition: all 0.2s; }
  .project-list .actions button:hover { background: #f0f4f8; border-color: #b0bec5; }
  .project-list .actions button.delete:hover { background: #fef2f2; border-color: #fca5a5; color: #dc2626; }
  .empty { color: #90a4ae; margin: 16px 0; }
</style>
</head>
<body>
<nav>
  <a class="logo" href="/"><img src="/static/lean-logo.svg" alt="Lean"></a>
  <span class="sep">/</span>
  <span class="user"><%= username %></span>
  <span class="spacer"></span>
  <a class="nav-link" href="/">Home</a>
  <a class="nav-link" href="/logout">Logout</a>
</nav>
<main>
<h1>Projects</h1>
<p><%= username %>'s workspaces</p>

<div class="new-project">
  <h3>New Project</h3>
  <input type="text" id="project-name" placeholder="Project name (letters, digits, hyphens, underscores)" maxlength="100">
  <textarea id="project-desc" placeholder="Description (optional)"></textarea>
  <button onclick="createProject()">Create</button>
</div>

<% if (projects.length === 0) { %>
  <p class="empty">No projects yet. Create one above.</p>
<% } else { %>
  <ul class="project-list">
  <% for (const p of projects) { %>
    <li>
      <div class="info">
        <a href="/<%= username %>/<%= encodeURIComponent(p.name) %>/"><%= p.name %></a>
        <% if (p.description) { %><div class="desc"><%= p.description %></div><% } %>
      </div>
      <div class="actions">
        <button onclick="editProject('<%= p.id %>', '<%= p.name.replace(/'/g, "\\'") %>', '<%= (p.description || '').replace(/'/g, "\\'") %>')">Edit</button>
        <button class="delete" onclick="removeProject('<%= p.id %>', '<%= p.name.replace(/'/g, "\\'") %>')">Delete</button>
      </div>
    </li>
  <% } %>
  </ul>
<% } %>
</main>

<script>
const username = '<%= username %>';
const apiBase = '/' + username + '/-/projects';

async function createProject() {
  const name = document.getElementById('project-name').value.trim();
  const description = document.getElementById('project-desc').value.trim();
  if (!name) { alert('Name is required'); return; }
  const res = await fetch(apiBase, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name, description: description || undefined }),
  });
  if (res.ok) { location.reload(); }
  else { const e = await res.json().catch(() => ({})); alert(e.error || 'Failed to create project'); }
}

function editProject(id, currentName, currentDesc) {
  const name = prompt('Project name:', currentName);
  if (name === null) return;
  if (!name.trim()) { alert('Name is required'); return; }
  const description = prompt('Description:', currentDesc);
  if (description === null) return;
  fetch(apiBase + '/' + id, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name.trim(), description: description.trim() || null }),
  }).then(res => {
    if (res.ok) location.reload();
    else res.json().catch(() => ({})).then(e => alert(e.error || 'Failed to update project'));
  });
}

function removeProject(id, name) {
  if (!confirm('Delete project "' + name + '"? Workspace files will be kept.')) return;
  fetch(apiBase + '/' + id, { method: 'DELETE' }).then(res => {
    if (res.ok) location.reload();
    else res.json().catch(() => ({})).then(e => alert(e.error || 'Failed to delete project'));
  });
}
</script>
</body>
</html>

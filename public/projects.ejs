<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title><%= username %> - Projects - Lean Workbench</title>
<style>
  body { font-family: system-ui, sans-serif; max-width: 700px; margin: 40px auto; padding: 0 20px; color: #333; }
  h1 { margin-bottom: 4px; }
  h1 + p { color: #666; margin-top: 0; }
  nav.top { margin-bottom: 24px; font-size: 14px; }
  nav.top a { color: #0078d4; text-decoration: none; }
  nav.top a:hover { text-decoration: underline; }
  nav.top .sep { margin: 0 6px; color: #999; }
  .new-project { margin: 20px 0; padding: 16px; background: #f5f5f5; border-radius: 6px; }
  .new-project h3 { margin: 0 0 10px; }
  .new-project input, .new-project textarea { display: block; width: 100%; margin-bottom: 8px; padding: 6px 8px; font-size: 14px; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; }
  .new-project textarea { height: 50px; resize: vertical; }
  .new-project button { padding: 6px 16px; font-size: 14px; background: #333; color: #fff; border: none; border-radius: 4px; cursor: pointer; }
  .new-project button:hover { background: #555; }
  .project-list { list-style: none; padding: 0; }
  .project-list li { padding: 10px 0; border-bottom: 1px solid #eee; display: flex; align-items: center; }
  .project-list li:last-child { border-bottom: none; }
  .project-list .info { flex: 1; }
  .project-list .info a { color: #0078d4; text-decoration: none; font-weight: 500; }
  .project-list .info a:hover { text-decoration: underline; }
  .project-list .info .desc { color: #666; font-size: 13px; margin-top: 2px; }
  .project-list .actions button { margin-left: 6px; padding: 3px 10px; font-size: 12px; border: 1px solid #ccc; border-radius: 3px; background: #fff; cursor: pointer; }
  .project-list .actions button:hover { background: #eee; }
  .project-list .actions button.delete:hover { background: #fdd; border-color: #d88; }
  .empty { color: #999; margin: 16px 0; }
</style>
</head>
<body>
<nav class="top">
  <a href="/">Home</a>
  <span class="sep">|</span>
  <span><%= username %></span>
  <span class="sep">|</span>
  <a href="/logout">Logout</a>
</nav>

<h1>Projects</h1>
<p><%= username %>'s workspaces</p>

<div class="new-project">
  <h3>New Project</h3>
  <input type="text" id="project-name" placeholder="Project name (letters, digits, hyphens, underscores)" maxlength="100">
  <textarea id="project-desc" placeholder="Description (optional)"></textarea>
  <button onclick="createProject()">Create</button>
</div>

<% if (projects.length === 0) { %>
  <p class="empty">No projects yet. Create one above.</p>
<% } else { %>
  <ul class="project-list">
  <% for (const p of projects) { %>
    <li>
      <div class="info">
        <a href="/<%= username %>/<%= encodeURIComponent(p.name) %>/"><%= p.name %></a>
        <% if (p.description) { %><div class="desc"><%= p.description %></div><% } %>
      </div>
      <div class="actions">
        <button onclick="editProject('<%= p.id %>', '<%= p.name.replace(/'/g, "\\'") %>', '<%= (p.description || '').replace(/'/g, "\\'") %>')">Edit</button>
        <button class="delete" onclick="removeProject('<%= p.id %>', '<%= p.name.replace(/'/g, "\\'") %>')">Delete</button>
      </div>
    </li>
  <% } %>
  </ul>
<% } %>

<script>
const username = '<%= username %>';
const apiBase = '/' + username + '/-/projects';

async function createProject() {
  const name = document.getElementById('project-name').value.trim();
  const description = document.getElementById('project-desc').value.trim();
  if (!name) { alert('Name is required'); return; }
  const res = await fetch(apiBase, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name, description: description || undefined }),
  });
  if (res.ok) { location.reload(); }
  else { const e = await res.json().catch(() => ({})); alert(e.error || 'Failed to create project'); }
}

function editProject(id, currentName, currentDesc) {
  const name = prompt('Project name:', currentName);
  if (name === null) return;
  if (!name.trim()) { alert('Name is required'); return; }
  const description = prompt('Description:', currentDesc);
  if (description === null) return;
  fetch(apiBase + '/' + id, {
    method: 'PUT',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ name: name.trim(), description: description.trim() || null }),
  }).then(res => {
    if (res.ok) location.reload();
    else res.json().catch(() => ({})).then(e => alert(e.error || 'Failed to update project'));
  });
}

function removeProject(id, name) {
  if (!confirm('Delete project "' + name + '"? Workspace files will be kept.')) return;
  fetch(apiBase + '/' + id, { method: 'DELETE' }).then(res => {
    if (res.ok) location.reload();
    else res.json().catch(() => ({})).then(e => alert(e.error || 'Failed to delete project'));
  });
}
</script>
</body>
</html>

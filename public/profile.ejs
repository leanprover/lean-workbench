<!DOCTYPE html>
<html>
<head>
<%- include('_head', { title: username + ' - Profile - Lean Workbench' }) %>
</head>
<body>
<nav>
  <a class="logo" href="/"><img src="/static/lean-logo.svg" alt="Lean" class="logo-img"><span class="logo-text">Lean Workbench</span></a>
  <span class="sep">/</span>
  <a class="breadcrumb" href="/<%= username %>/"><%= username %></a>
  <span class="spacer"></span>
  <%- include('_avatar-menu', { username, avatarUrl, isAdmin, links: [...(isAdmin ? [{ href: '/admin', label: 'Admin' }] : [])] }) %>
</nav>
<div id="root"></div>
<script>window.__DATA__ = { username: '<%- username %>', isAdmin: <%= isAdmin ? 'true' : 'false' %>, isOwner: <%= isOwner ? 'true' : 'false' %> };</script>
<script type="module" src="/static/dist/profile.js"></script>
</body>
</html>

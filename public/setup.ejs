<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>Lean Workbench Setup</title>
<link rel="icon" href="/static/favicon.ico">
<link rel="stylesheet" href="/static/style.css">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600&display=swap">
<style>
.setup-btn {
  display: inline-block;
  margin: 20px 0;
  padding: 10px 20px;
  font-size: 14px;
  background: #386EE0;
  color: #fff;
  border: none;
  border-radius: 0.5rem;
  font-weight: 500;
  cursor: pointer;
  font-family: inherit;
  transition: background 0.2s;
}
.setup-btn:hover { background: #1D4ED8; }
.setup-btn:disabled { background: #90a4ae; cursor: not-allowed; }
.form-field {
  margin-bottom: 12px;
}
.form-field label {
  display: block;
  font-size: 13px;
  font-weight: 600;
  margin-bottom: 4px;
}
.form-field input {
  width: 100%;
  padding: 8px 10px;
  font-size: 14px;
  border: 1px solid #D1D9E2;
  border-radius: 0.5rem;
  font-family: inherit;
  box-sizing: border-box;
}
.form-field input:disabled {
  background: #f5f5f5;
  color: #999;
}
.form-field .hint {
  font-size: 11px;
  color: #90a4ae;
  margin-top: 2px;
}
.section-divider {
  border: none;
  border-top: 1px solid #E4EBF3;
  margin: 24px 0;
}
.progress-area {
  display: none;
  margin: 20px 0;
}
.progress-bar-outer {
  width: 100%;
  height: 8px;
  background: #E4EBF3;
  border-radius: 4px;
  overflow: hidden;
}
.progress-bar-inner {
  height: 100%;
  width: 0%;
  background: #386EE0;
  border-radius: 4px;
  transition: width 0.4s ease;
}
.progress-label {
  margin-top: 8px;
  font-size: 13px;
  color: #607D8B;
  display: flex;
  align-items: center;
  gap: 6px;
}
.progress-label .spinner {
  display: inline-block;
  width: 12px;
  height: 12px;
  border: 2px solid #D1D9E2;
  border-top-color: #386EE0;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  flex-shrink: 0;
}
@keyframes spin { to { transform: rotate(360deg); } }
.log-area {
  display: none;
  margin: 12px 0;
  padding: 12px;
  background: #1a1a2e;
  color: #a0d0a0;
  border-radius: 0.5rem;
  font-family: 'Courier New', monospace;
  font-size: 12px;
  line-height: 1.5;
  max-height: 300px;
  overflow-y: auto;
  white-space: pre-wrap;
  word-break: break-all;
}
.done-message {
  display: none;
  margin: 20px 0;
  padding: 12px 16px;
  background: #f0fdf4;
  border: 1px solid #86efac;
  border-radius: 0.5rem;
  color: #166534;
  font-weight: 500;
}
.done-message a { color: #386EE0; text-decoration: none; font-weight: 600; }
.done-message a:hover { text-decoration: underline; }
.error-message {
  display: none;
  margin: 20px 0;
  padding: 12px 16px;
  background: #fef2f2;
  border: 1px solid #fca5a5;
  border-radius: 0.5rem;
  color: #dc2626;
  font-weight: 500;
}
</style>
</head>
<body>
<nav>
  <a class="logo" href="/setup"><img src="/static/lean-logo.svg" alt="Lean" class="logo-img"><span class="logo-text">Lean Workbench</span></a>
  <span class="spacer"></span>
</nav>
<main style="max-width: 600px;">
<h1>Setup</h1>

<h2>Step 1: GitHub Authentication</h2>
<p style="color: #607D8B; font-size: 13px;">
  Create a <a href="https://github.com/settings/developers" target="_blank">GitHub OAuth App</a>
  and enter the credentials below.
  Set the "Authorization callback URL" to the value shown below.
</p>

<div id="oauth-form">
  <div class="form-field">
    <label>Client ID</label>
    <input type="text" id="client-id" placeholder="Ov23li...">
  </div>
  <div class="form-field">
    <label>Client Secret</label>
    <input type="password" id="client-secret" placeholder="Enter client secret">
  </div>
  <div class="form-field">
    <label>Callback URL</label>
    <input type="text" id="callback-url">
    <div class="hint">Use this as the "Authorization callback URL" in your GitHub OAuth App.</div>
  </div>
  <button class="setup-btn" id="save-config-btn" onclick="saveConfig()">Save Configuration</button>
</div>

<div class="done-message" id="config-saved" style="display:none;">Authentication configured.</div>
<div class="error-message" id="config-error" style="display:none;"></div>

<hr class="section-divider">

<h2>Step 2: Initialize Data Volume</h2>
<p style="color: #607D8B; font-size: 13px;">
  Install elan, download pre-compiled Mathlib, and set up
  project templates. This may take several minutes.
</p>

<button class="setup-btn" id="start-btn" onclick="startSetup()" disabled>Start Setup</button>

<div class="progress-area" id="progress-area">
  <div class="progress-bar-outer">
    <div class="progress-bar-inner" id="progress-bar"></div>
  </div>
  <div class="progress-label">
    <span class="spinner"></span>
    <span id="progress-text">Starting...</span>
  </div>
</div>

<div class="log-area" id="log-area"></div>

<div class="done-message" id="done-message">
  Setup complete! <a href="/">Continue to Lean Workbench</a>
</div>

<div class="error-message" id="error-message">
  Setup failed. Check the log output above for details.
</div>

<script>
// Auto-fill callback URL from current origin
document.getElementById('callback-url').value =
  window.location.origin + '/auth/github/callback';

// On page load, check if config is already saved (e.g., page reload)
fetch('/api/setup/status')
  .then(function(res) { return res.json(); })
  .then(function(data) {
    if (data.configSaved) {
      lockConfigForm();
    }
    if (data.seeding) {
      document.getElementById('start-btn').disabled = true;
      document.getElementById('start-btn').textContent = 'Setting up...';
      document.getElementById('progress-area').style.display = 'block';
      document.getElementById('log-area').style.display = 'block';
      streamLogs();
    }
    if (data.seeded) {
      lockConfigForm();
      showDone();
    }
  });

function lockConfigForm() {
  var inputs = document.querySelectorAll('#oauth-form input');
  for (var i = 0; i < inputs.length; i++) inputs[i].disabled = true;
  document.getElementById('save-config-btn').style.display = 'none';
  document.getElementById('config-saved').style.display = 'block';
  document.getElementById('config-error').style.display = 'none';
  document.getElementById('start-btn').disabled = false;
}

function saveConfig() {
  var btn = document.getElementById('save-config-btn');
  var clientId = document.getElementById('client-id').value.trim();
  var clientSecret = document.getElementById('client-secret').value.trim();
  var callbackUrl = document.getElementById('callback-url').value.trim();

  if (!clientId || !clientSecret) {
    showConfigError('Client ID and Client Secret are required.');
    return;
  }

  btn.disabled = true;
  btn.textContent = 'Saving...';

  fetch('/api/setup/config', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      githubClientId: clientId,
      githubClientSecret: clientSecret,
      callbackUrl: callbackUrl
    })
  })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.error) {
        showConfigError(data.error);
        btn.disabled = false;
        btn.textContent = 'Save Configuration';
        return;
      }
      lockConfigForm();
    })
    .catch(function(err) {
      showConfigError(err.message);
      btn.disabled = false;
      btn.textContent = 'Save Configuration';
    });
}

function showConfigError(msg) {
  var el = document.getElementById('config-error');
  el.textContent = msg;
  el.style.display = 'block';
}

function startSetup() {
  var btn = document.getElementById('start-btn');
  var progressArea = document.getElementById('progress-area');
  var logArea = document.getElementById('log-area');

  btn.disabled = true;
  btn.textContent = 'Setting up...';
  progressArea.style.display = 'block';
  logArea.style.display = 'block';

  fetch('/api/setup/seed', { method: 'POST' })
    .then(function(res) { return res.json(); })
    .then(function(data) {
      if (data.error) {
        showError(data.error);
        return;
      }
      streamLogs();
    })
    .catch(function(err) { showError(err.message); });
}

function streamLogs() {
  var logArea = document.getElementById('log-area');
  var progressBar = document.getElementById('progress-bar');
  var progressText = document.getElementById('progress-text');
  var source = new EventSource('/api/setup/stream');

  source.onmessage = function(event) {
    var data = JSON.parse(event.data);
    if (data.type === 'progress') {
      var pct = Math.round((data.step / data.total) * 100);
      progressBar.style.width = pct + '%';
      progressText.textContent = data.label + ' (' + data.step + '/' + data.total + ')';
    } else if (data.type === 'log') {
      var atBottom = logArea.scrollHeight - logArea.scrollTop - logArea.clientHeight < 2;
      logArea.appendChild(document.createTextNode(data.line + '\n'));
      if (atBottom) logArea.scrollTop = logArea.scrollHeight;
    } else if (data.type === 'done') {
      source.close();
      progressBar.style.width = '100%';
      showDone();
    } else if (data.type === 'error') {
      source.close();
      showError(data.message);
    }
  };

  source.onerror = function() {
    source.close();
    fetch('/api/setup/status')
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (data.seeded) showDone();
        else if (!data.seeding) showError('Connection lost');
      });
  };
}

function showDone() {
  document.getElementById('progress-area').style.display = 'none';
  document.getElementById('start-btn').style.display = 'none';
  document.getElementById('done-message').style.display = 'block';
}

function showError(msg) {
  document.getElementById('progress-area').style.display = 'none';
  var el = document.getElementById('error-message');
  el.textContent = 'Setup failed: ' + msg;
  el.style.display = 'block';
  var btn = document.getElementById('start-btn');
  btn.disabled = false;
  btn.textContent = 'Retry Setup';
}
</script>
</main>
</body>
</html>

<!DOCTYPE html>
<html>
<head>
<%- include('_head', { title: 'Lean Workbench' }) %>
</head>
<body>
<nav>
  <a class="logo" href="/"><img src="/static/lean-logo.svg" alt="Lean" class="logo-img"><span class="logo-text">Lean Workbench</span></a>
  <span class="spacer"></span>
<% if (user) { %>
  <%- include('_avatar-menu', { username: user.username, avatarUrl: user.avatarUrl, isAdmin: user.isAdmin, links: [{ href: '/' + user.username + '/', label: 'Profile' }] }) %>
<% } else if (githubEnabled) { %>
  <a class="nav-link" href="/auth/github">Login</a>
<% } %>
</nav>
<main style="max-width: 600px;">
<h1>Lean Workbench</h1>
<p>Multi-user sandboxed VS Code server.</p>

<script>
if (new URLSearchParams(window.location.search).get('error') === 'not_allowed') {
  document.write('<div style="background:#fef2f2;border:1px solid #fecaca;color:#991b1b;padding:12px 16px;border-radius:8px;margin-bottom:16px;">Your GitHub account is not on the allowlist. Contact an administrator.</div>');
}
</script>

<% if (user) { %>
  <div class="welcome">
    <h2>Welcome, <%= user.username %></h2>
    <p><a href="/<%= user.username %>/">Go to your profile</a></p>
  </div>
<% } else { %>
<% if (githubEnabled) { %>
  <a class="login-link" href="/auth/github">Login with GitHub</a>
<% } %>
<% if (devMode) { %>
  <a class="login-link" href="/dev-login">Dev Login</a>
  <a class="login-link" href="/dev-admin-login">Dev Admin Login</a>
<% } %>
<% } %>
</main>
</body>
</html>

generator client {
  provider = "prisma-client"
  output   = "./generated"
}

datasource db {
  provider = "sqlite"
}

// Tables required by better-auth
// See https://better-auth.com/docs/concepts/database#core-schema

model User {
  /// Better-auth identifier (matches BETTERAUTH_ID_RE)
  id            String    @id
  /// Better-auth does not require uniqueness but we do.
  /// These names serve two distinct purposes that require uniqueness.
  ///
  /// First, they are a user-controlled identifier that appears in a URL as to signify the project's owner
  /// (e.g. https://example.com/my-user-name/my-first-project).
  ///
  /// Second, they are unique long-lasting filesystem identifiers used to group a user's project
  /// data on the file system.
  ///
  /// (It's possible that in the future we will want to tease these apart,
  /// and allow the URL-appearing identifier to be changed more freely by users.)
  ///
  /// Names must match `ALPHANUM_NAME_RE`.
  /// This column is `COLLATE NOCASE` in migration.sql
  /// (Prisma cannot express SQLite collation settings),
  /// so uniqueness and lookups are case-insensitive
  /// while original casing is preserved for display.
  /// Ensure that this remains the case if changing migration.sql.
  name          String    @unique
  /// `COLLATE NOCASE` in migration.sql; see `User.name`.
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  sessions      Session[]
  accounts      Account[]

  // Workbench-specific fields
  displayName String?
  isAdmin     Boolean   @default(false)
  /// Projects owned by this user.
  /// TODO: The user may also have read/write access to other users' projects.
  projects    Project[]

  @@map("user")
}

model Session {
  /// Better-auth identifier (matches BETTERAUTH_ID_RE)
  id        String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("session")
}

model Account {
  /// Better-auth identifier (matches BETTERAUTH_ID_RE)
  id                    String    @id
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                String
  /// Better-auth convention is that accountId=userId when providerId='credential'.
  /// When providerId='github', accountId is a numeric ID assigned to the account by GitHub
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  /// (Better-auth implementation detail:) this value is `$SALT:scrypt($PASSWORD, $SALT)`
  /// where `$SALT` is randomly generated per-password.
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @default(now()) @updatedAt

  @@map("account")
}

model Verification {
  /// Better-auth identifier (matches BETTERAUTH_ID_RE)
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@map("verification")
}

// Workbench-specific tables

model Project {
  /// 128-bit UUID.
  id          String              @id
  /// Project's owner.
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  /// `COLLATE NOCASE` in migration.sql; see `User.name`.
  name        String
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @default(now()) @updatedAt
  /// Which template the project was created from.
  template    String
  isPublic    Boolean             @default(false)
  packageSets ProjectPackageSet[]

  @@unique([userId, name])
  @@map("project")
}

/// Package set pulled in by a given project.
model ProjectPackageSet {
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId  String
  packageSet String

  @@id([projectId, packageSet])
  @@map("project_package_set")
}

/// GitHub accounts allowed to register in `restricted` registration mode.
model AllowedGithubUser {
  /// `COLLATE NOCASE` in migration.sql; see `User.name`.
  githubUsername String @id

  @@map("allowed_github_user")
}

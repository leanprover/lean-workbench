# Development-only overrides.
# In production, OAuth is configured through the web setup UI.

# GitHub OAuth (dev mode — these override the database config if set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CALLBACK_URL=http://localhost:3000/auth/github/callback

# Session secret (auto-generated in production setup)
SESSION_SECRET=lean-workbench-dev-secret

# Set to "production" to disable dev-login
# NODE_ENV=production

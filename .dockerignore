# Ignore everything by default, then allow only what the Dockerfile build needs.
*

# Next.js server
!public
!src
!next-env.d.ts
!next.config.ts
!package-lock.json
!package.json
!prisma.config.ts
!tsconfig.json

# Collaboration server
!collab-server/dist

# Pre-built workbench extension
